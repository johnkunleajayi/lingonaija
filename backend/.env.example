# Safe template only. Copy to backend/.env and configure privately.
# Native Neon postgresql:// URLs are accepted; use exactly two scheme slashes.
DATABASE_URL=postgresql+psycopg://lingonaija:change-this-local-password@localhost:5432/lingonaija
# Neon alternative: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
CORS_ORIGINS=["http://127.0.0.1:5173"]
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
FRONTEND_URL=http://127.0.0.1:5173
GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/auth/google/callback
COOKIE_SECURE=false
SESSION_DAYS=7
